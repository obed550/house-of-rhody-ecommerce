# Paystack (Optional - for payments)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_your_public_key"
PAYSTACK_SECRET_KEY="sk_test_your_secret_key"

# App Configuration
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NODE_ENV="development"

